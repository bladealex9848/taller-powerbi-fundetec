# Proteger el archivo .htaccess de accesos externos
<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>

# Proteger archivos sensibles (CORREGIDO - permitir logs internos)
<FilesMatch "\.(env|bak|backup|old)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger error_log específicamente del acceso web externo pero permitir acceso interno PHP
<Files "error_log">
    Order allow,deny
    Deny from all
</Files>

# Permitir acceso a archivos PHP principales
<FilesMatch "\.(php)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Forzar redirección a HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Deshabilitar listado de directorios
Options -Indexes

# Página de inicio por defecto
DirectoryIndex index.php index.html